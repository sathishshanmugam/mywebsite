rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function phoneAccess() {
      return get(
        /databases/$(database)/documents/staff_access/$(request.auth.token.phone_number)
      );
    }

    function activeOutletStaff() {
      return signedIn()
        && phoneAccess().data.active != false
        && phoneAccess().data.outletId is string;
    }

    function ownsOutlet(outletId) {
      return activeOutletStaff()
        && phoneAccess().data.outletId == outletId;
    }

    // One document per company login phone number.
    // Example document ID: +919876543210
    //
    // Fields:
    //   outletId: "karur"
    //   outletName: "Karur"
    //   active: true
    match /staff_access/{phoneNumber} {
      allow read: if signedIn()
        && request.auth.token.phone_number == phoneNumber
        && resource.data.active != false;

      // Configure these documents manually from the Firebase Console.
      allow write: if false;
    }

    // Public website needs to read active outlet information.
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if false;
    }

    // Public website reads availability.
    // Staff can write only availability belonging to their own outlet.
    match /outlet_products/{docId} {
      allow read: if true;

      allow create, update: if activeOutletStaff()
        && ownsOutlet(request.resource.data.outletId)
        && request.resource.data.productId is string
        && request.resource.data.available is bool;

      allow delete: if false;
    }
  }
}
